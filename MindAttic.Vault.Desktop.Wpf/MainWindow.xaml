<Window x:Class="MindAttic.Vault.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="clr-namespace:MindAttic.Components.Wpf.Controls;assembly=MindAttic.Components.Wpf"
        xmlns:services="clr-namespace:MindAttic.Vault.Desktop.Services"
        Title="{Binding Title}" Width="1100" Height="760" MinWidth="640" MinHeight="420"
        Background="{DynamicResource MaChrome}" Foreground="{DynamicResource MaText}"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <!-- Top bar: the global Profile picker. Every tab loads from and saves to the chosen Profile. -->
        <Grid DockPanel.Dock="Top" Margin="16,10,16,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Title}" Style="{StaticResource MaHeading}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="Profile" Style="{StaticResource MaMutedText}" VerticalAlignment="Center" Margin="0,0,8,0" />
            <mc:MaPicker Grid.Column="2" Width="240" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}"
                         DisplayMemberPath="DisplayName" AutomationProperties.Name="Profile"
                         ToolTip="Where every tab loads from and saves to" />
        </Grid>

        <Border DockPanel.Dock="Top" Style="{StaticResource MaInsetCard}" Margin="16,0,16,6"
                Visibility="{Binding HasProfileNotice, Converter={StaticResource Visible}}">
            <TextBlock Text="{Binding ProfileNotice}" TextWrapping="Wrap" Foreground="{DynamicResource MaWarn}"
                       AutomationProperties.LiveSetting="Assertive" />
        </Border>

        <!-- Folder permissions (RFC 0003 Security 5): local keys are plain text, so other accounts must not read them. -->
        <Border DockPanel.Dock="Top" Style="{StaticResource MaInsetCard}" Margin="16,0,16,6"
                Visibility="{Binding HasFolderAccessWarning, Converter={StaticResource Visible}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Fix" Style="{StaticResource MaPrimaryButton}" Margin="12,0,0,0" VerticalAlignment="Center"
                        Command="{Binding FixFolderAccessCommand}" AutomationProperties.Name="Fix the Vault folder permissions" />
                <TextBlock Text="{Binding FolderAccessWarning}" TextWrapping="Wrap" Foreground="{DynamicResource MaWarn}"
                           AutomationProperties.LiveSetting="Assertive" />
            </DockPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Style="{StaticResource MaStatusBar}">
            <TextBlock Text="{Binding StatusText}" Style="{StaticResource MaMutedText}" TextTrimming="CharacterEllipsis"
                       AutomationProperties.Name="Status" AutomationProperties.LiveSetting="Polite" />
        </Border>

        <!-- Every tab is as wide as the longest name (M.VALT-T64), recomputed on load, resize and when tabs change. -->
        <mc:MaTabControl x:Name="Tabs" ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab}"
                         services:EqualTabWidths.IsEnabled="True"
                         AutomationProperties.Name="Settings tabs">
            <mc:MaTabControl.ItemContainerStyle>
                <Style TargetType="mc:MaTabItem" BasedOn="{StaticResource {x:Type mc:MaTabItem}}">
                    <Setter Property="Trailing" Value="{Binding Trailing}" />
                    <Setter Property="Status" Value="{Binding Status}" />
                    <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
                </Style>
            </mc:MaTabControl.ItemContainerStyle>
            <mc:MaTabControl.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Title}" />
                </DataTemplate>
            </mc:MaTabControl.ItemTemplate>
        </mc:MaTabControl>
    </DockPanel>
</Window>
