<UserControl x:Class="MindAttic.Vault.Desktop.Views.CredentialsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="clr-namespace:MindAttic.Components.Wpf.Controls;assembly=MindAttic.Components.Wpf">
    <DockPanel Margin="16,12,16,8">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Credentials" Style="{StaticResource MaHeading}" />
            <TextBlock Style="{StaticResource MaMutedText}" TextWrapping="Wrap"
                       Text="Logins and connection details several apps share (email, SMS, subtitles, audio storage, brokers, FTP, tokens, hosting). Each group stays where apps read it. Secret fields stay masked; fields you don't touch are saved exactly as they were." />
            <Border Style="{StaticResource MaInsetCard}" Margin="0,8,0,0" Visibility="{Binding HasNotice, Converter={StaticResource Visible}}">
                <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" Foreground="{DynamicResource MaWarn}" />
            </Border>
        </StackPanel>

        <ScrollViewer Style="{StaticResource MaBodyScroll}" Margin="0,10,0,0" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Groups}" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Expander IsExpanded="{Binding IsExpanded}" Margin="0,0,0,10" Foreground="{DynamicResource MaText}">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource MaSectionLabel}" />
                                    <TextBlock Text="{Binding Trailing}" Style="{StaticResource MaMutedText}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Expander.Header>
                            <Border Style="{StaticResource MaCard}" Margin="0,6,0,0">
                                <StackPanel>
                                    <!-- Group header: what it is, where it lives, Save / Revert. -->
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                            <Button Content="Revert" Style="{StaticResource MaButton}" Command="{Binding RevertCommand}" Margin="0,0,8,0"
                                                    ToolTip="Drop your edits to this group and reload it"
                                                    AutomationProperties.Name="{Binding Title, StringFormat='Revert {0}'}" />
                                            <Button Content="Save" Style="{StaticResource MaPrimaryButton}" Command="{Binding SaveCommand}"
                                                    ToolTip="Save this group (fields you didn't touch stay as they were)"
                                                    AutomationProperties.Name="{Binding Title, StringFormat='Save {0}'}" />
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Description}" TextWrapping="Wrap"
                                                       Visibility="{Binding HasDescription, Converter={StaticResource Visible}}" />
                                            <TextBlock Text="{Binding Location}" Style="{StaticResource MaMutedText}" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding StatusText}" Style="{StaticResource MaMutedText}" TextWrapping="Wrap"
                                                       AutomationProperties.LiveSetting="Polite" />
                                        </StackPanel>
                                    </DockPanel>

                                    <!-- Entries, each with its fields as rows. -->
                                    <ItemsControl ItemsSource="{Binding Entries}" Focusable="False" Margin="0,6,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{DynamicResource MaChromeBorder}" BorderThickness="0,1,0,0" Padding="0,8,0,8">
                                                    <StackPanel>
                                                        <DockPanel>
                                                            <Button DockPanel.Dock="Right" Style="{StaticResource MaToolButton}" Content="&#xE74D;"
                                                                    Command="{Binding RemoveCommand}" ToolTip="Remove this entry (on Save)"
                                                                    Visibility="{Binding CanRemove, Converter={StaticResource Visible}}"
                                                                    AutomationProperties.Name="{Binding Title, StringFormat='Remove {0}'}" />
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                                                <TextBlock Text="{Binding FullName}" Style="{StaticResource MaMutedText}" />
                                                            </StackPanel>
                                                        </DockPanel>
                                                        <ItemsControl ItemsSource="{Binding Fields}" Focusable="False" Margin="0,4,0,0">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Grid Margin="0,3,0,3">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="200" />
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <StackPanel VerticalAlignment="Center" ToolTip="{Binding FullName}">
                                                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                                            <TextBlock Text="{Binding KindLabel}" Style="{StaticResource MaMutedText}" />
                                                                        </StackPanel>
                                                                        <TextBox Grid.Column="1" Style="{StaticResource MaTextBox}" Margin="8,0"
                                                                                 Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                                                                                 Visibility="{Binding ShowTextBox, Converter={StaticResource Visible}}"
                                                                                 AutomationProperties.Name="{Binding FullName}" />
                                                                        <mc:MaSecretBox Grid.Column="1" Margin="8,0" Loaded="Secret_Loaded" SecretChanged="Secret_Changed"
                                                                                        Visibility="{Binding ShowSecretBox, Converter={StaticResource Visible}}"
                                                                                        AutomationProperties.Name="{Binding FullName, StringFormat='Value of {0}'}" />
                                                                        <TextBlock Grid.Column="1" Margin="8,0" VerticalAlignment="Center" Style="{StaticResource MaMutedText}"
                                                                                   Text="Kept as it is (edit the file to change it)"
                                                                                   Visibility="{Binding ShowNested, Converter={StaticResource Visible}}" />
                                                                        <Button Grid.Column="2" Style="{StaticResource MaToolButton}" Content="&#xE711;"
                                                                                Command="{Binding RemoveCommand}" ToolTip="Remove this field (on Save)"
                                                                                AutomationProperties.Name="{Binding Name, StringFormat='Remove field {0}'}" />
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                        <WrapPanel Margin="0,4,0,0">
                                                            <TextBox Text="{Binding NewFieldName, UpdateSourceTrigger=PropertyChanged}" Width="200"
                                                                     Style="{StaticResource MaTextBox}" Margin="0,0,6,0"
                                                                     ToolTip="Name of the field (a name with password, secret, key or token in it is masked)"
                                                                     AutomationProperties.Name="{Binding Title, StringFormat='New field name for {0}'}" />
                                                            <Button Content="{Binding AddLabel}" Style="{StaticResource MaButton}" Command="{Binding AddFieldCommand}" />
                                                        </WrapPanel>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Add an entry (providers.json groups). -->
                                    <WrapPanel Margin="0,8,0,0" Visibility="{Binding CanAddEntries, Converter={StaticResource Visible}}">
                                        <TextBox Text="{Binding NewEntryName, UpdateSourceTrigger=PropertyChanged}" Width="200" Style="{StaticResource MaTextBox}"
                                                 Margin="0,0,6,0" ToolTip="The entry's name, e.g. alpaca-paper"
                                                 AutomationProperties.Name="{Binding Title, StringFormat='New entry name for {0}'}" />
                                        <Button Content="Add entry" Style="{StaticResource MaButton}" Command="{Binding AddEntryCommand}" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </Expander>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
