<UserControl x:Class="MindAttic.Vault.Desktop.Views.KeysView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="clr-namespace:MindAttic.Components.Wpf.Controls;assembly=MindAttic.Components.Wpf">
    <DockPanel Margin="16,12,16,8">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Keys" Style="{StaticResource MaHeading}" />
            <TextBlock Style="{StaticResource MaMutedText}" TextWrapping="Wrap"
                       Text="One shared list per provider for every MindAttic app, tried in this order. Apps pick which keys they use on their own tabs. Values stay masked; reveal or copy them only when you need to." />
            <Border Style="{StaticResource MaInsetCard}" Margin="0,8,0,0" Visibility="{Binding HasNotice, Converter={StaticResource Visible}}">
                <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" Foreground="{DynamicResource MaWarn}" />
            </Border>
        </StackPanel>

        <ScrollViewer Style="{StaticResource MaBodyScroll}" Margin="0,10,0,0" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Groups}" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Expander IsExpanded="{Binding IsExpanded}" Margin="0,0,0,10" Foreground="{DynamicResource MaText}">
                            <Expander.Header>
                                <TextBlock Text="{Binding Title}" Style="{StaticResource MaSectionLabel}" />
                            </Expander.Header>
                            <ItemsControl ItemsSource="{Binding Providers}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource MaCard}" Margin="0,6,0,0">
                                            <StackPanel>
                                                <!-- Provider header -->
                                                <DockPanel>
                                                    <Button DockPanel.Dock="Right" Content="Get a key" Style="{StaticResource MaTextButton}"
                                                            Command="{Binding OpenKeyPageCommand}"
                                                            Visibility="{Binding HasKeyPage, Converter={StaticResource Visible}}"
                                                            AutomationProperties.Name="{Binding DisplayName, StringFormat='Open the {0} key page'}" />
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="15" />
                                                        <TextBlock Text="{Binding Summary}" Style="{StaticResource MaMutedText}" />
                                                        <TextBlock Text="{Binding TestMessage}" Style="{StaticResource MaMutedText}"
                                                                   AutomationProperties.LiveSetting="Polite" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </DockPanel>

                                                <!-- Keys in failover order -->
                                                <ItemsControl ItemsSource="{Binding Keys}" Focusable="False" Margin="0,6,0,0">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border BorderBrush="{DynamicResource MaChromeBorder}" BorderThickness="0,1,0,0" Padding="0,8,0,8">
                                                                <StackPanel>
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <mc:MaStatusLight Status="{Binding Light}" Label="{Binding StatusLabel}" VerticalAlignment="Center" />
                                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" />
                                                                        <TextBlock Text="{Binding StatusLine}" Style="{StaticResource MaMutedText}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                                                    </StackPanel>
                                                                    <TextBlock Text="{Binding UsedBy}" Style="{StaticResource MaMutedText}" TextWrapping="Wrap" Margin="0,2,0,6" />
                                                                    <WrapPanel>
                                                                        <mc:MaSecretBox x:Name="Secret" Width="280" Margin="0,0,6,4" Loaded="Secret_Loaded"
                                                                                        SecretChanged="Secret_Changed"
                                                                                        AutomationProperties.Name="{Binding Name, StringFormat='Value of {0}'}" />
                                                                        <Button x:Name="SaveValue" Content="Save value" Style="{StaticResource MaButton}" Margin="0,0,6,4"
                                                                                IsEnabled="False" Tag="{Binding ElementName=Secret}" Click="SaveValue_Click"
                                                                                ToolTip="Store the edited value (the key's health starts over)" />
                                                                        <Button Content="Test" Style="{StaticResource MaButton}" Margin="0,0,12,4"
                                                                                Command="{Binding TestCommand}" ToolTip="One cheap call to the provider with this key" />
                                                                        <TextBox Text="{Binding RenameText, UpdateSourceTrigger=PropertyChanged}" Width="170"
                                                                                 Style="{StaticResource MaTextBox}" Margin="0,0,6,4"
                                                                                 AutomationProperties.Name="{Binding Name, StringFormat='New name for {0}'}" />
                                                                        <Button Content="Rename" Style="{StaticResource MaButton}" Margin="0,0,12,4" Command="{Binding RenameCommand}" />
                                                                        <Button Content="{Binding DisableLabel}" Style="{StaticResource MaButton}" Margin="0,0,6,4"
                                                                                Command="{Binding ToggleDisabledCommand}" ToolTip="Disabled keys are skipped by every app" />
                                                                        <Button Style="{StaticResource MaToolButton}" Content="&#xE70E;" Command="{Binding MoveUpCommand}"
                                                                                ToolTip="Try earlier" AutomationProperties.Name="{Binding Name, StringFormat='Move {0} up'}" />
                                                                        <Button Style="{StaticResource MaToolButton}" Content="&#xE70D;" Command="{Binding MoveDownCommand}"
                                                                                ToolTip="Try later" AutomationProperties.Name="{Binding Name, StringFormat='Move {0} down'}" />
                                                                        <Button Style="{StaticResource MaToolButton}" Content="&#xE74D;" Command="{Binding RemoveCommand}"
                                                                                ToolTip="Remove this key" AutomationProperties.Name="{Binding Name, StringFormat='Remove {0}'}" />
                                                                    </WrapPanel>
                                                                    <TextBlock Text="{Binding TestMessage}" Style="{StaticResource MaMutedText}" TextWrapping="Wrap" />
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <!-- Add a key -->
                                                <WrapPanel Margin="0,8,0,0">
                                                    <TextBox Text="{Binding NewKeyName, UpdateSourceTrigger=PropertyChanged}" Width="170" Style="{StaticResource MaTextBox}"
                                                             Margin="0,0,6,4" ToolTip="A name you choose, e.g. 2026-10-31 IdiotProof (blank: key1, key2…)"
                                                             AutomationProperties.Name="{Binding DisplayName, StringFormat='Name for a new {0} key'}" />
                                                    <mc:MaSecretBox x:Name="NewSecret" Width="280" Margin="0,0,6,4" Placeholder="Paste a key"
                                                                    AutomationProperties.Name="{Binding DisplayName, StringFormat='New {0} key value'}" />
                                                    <Button Content="Add key" Style="{StaticResource MaPrimaryButton}" Margin="0,0,0,4"
                                                            Tag="{Binding ElementName=NewSecret}" Click="AddKey_Click" />
                                                </WrapPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Expander>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
