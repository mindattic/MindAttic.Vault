<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:MindAttic.Vault.Desktop.ViewModels"
                    xmlns:views="clr-namespace:MindAttic.Vault.Desktop.Views"
                    xmlns:azure="clr-namespace:MindAttic.Vault.Desktop.Azure.Setup;assembly=MindAttic.Vault.Desktop.Azure">
    <!-- Views are DataTemplates keyed by view-model type (RFC 0003 section 8). -->
    <DataTemplate DataType="{x:Type vm:ProfileSetupTabViewModel}">
        <ContentPresenter Content="{Binding Content}" />
    </DataTemplate>
    <DataTemplate DataType="{x:Type azure:AzureSetupViewModel}">
        <azure:AzureSetupView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:GetStartedViewModel}">
        <views:GetStartedView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:KeysViewModel}">
        <views:KeysView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:AppSettingsViewModel}">
        <views:AppSettingsView />
    </DataTemplate>
</ResourceDictionary>
