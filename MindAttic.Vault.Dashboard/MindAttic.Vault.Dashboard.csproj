<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MindAttic.Vault.Dashboard</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Credential resolution lives in the local Vault project (the repo this app
         ships in). It unifies over the Vault 0.3.0 that Legion pulls transitively. -->
    <ProjectReference Include="..\MindAttic.Vault\MindAttic.Vault.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Probe + diagnosis + live model discovery â€” reused, not reinvented. -->
    <PackageReference Include="MindAttic.Legion" Version="12.0.0" />

    <!-- Azure Key Vault as a configuration source (managed identity in App Service). -->
    <PackageReference Include="Azure.Identity" Version="1.13.1" />
    <PackageReference Include="Azure.Extensions.AspNetCore.Configuration.Secrets" Version="1.3.2" />
  </ItemGroup>

</Project>
