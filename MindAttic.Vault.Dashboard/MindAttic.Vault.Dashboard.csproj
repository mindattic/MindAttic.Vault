<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MindAttic.Vault.Dashboard</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Probe + diagnosis + live model discovery - reused, not reinvented. -->
    <PackageReference Include="MindAttic.Legion" Version="21.0.0" />
    <!-- Credential resolution via the published Vault package. -->
    <PackageReference Include="MindAttic.Vault" Version="1.0.0" />

    <!-- Azure Key Vault as a configuration source (managed identity in App Service). -->
    <PackageReference Include="Azure.Identity" Version="1.13.1" />
    <PackageReference Include="Azure.Extensions.AspNetCore.Configuration.Secrets" Version="1.3.2" />
  </ItemGroup>

</Project>
