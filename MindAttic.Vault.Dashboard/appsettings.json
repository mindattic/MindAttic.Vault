{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "MindAttic": {
    "Vault": {
      "//KeyVaultUri": "Set in Azure App Service settings, e.g. https://mindattic-kv.vault.azure.net/. Leave unset locally to use %APPDATA%\\MindAttic\\LLM\\providers.json.",
      "KeyVaultUri": ""
    }
  },

  "Monitor": {
    "Interval": "01:00:00",
    "ProbeTimeout": "00:00:30",
    "TrustedProviders": [ "claude", "openai", "gemini", "deepseek" ],
    "MonitorAllKeyed": true,
    "SelfHealModels": true,
    "Webhooks": [],
    "Email": null
  }
}
