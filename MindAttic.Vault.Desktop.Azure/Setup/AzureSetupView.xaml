<UserControl x:Class="MindAttic.Vault.Desktop.Azure.Setup.AzureSetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:setup="clr-namespace:MindAttic.Vault.Desktop.Azure.Setup"
             AutomationProperties.Name="Azure setup">
    <!-- Sign-in + resource picker for the Azure Profile. Styles come from MindAttic.Components.Wpf's theme
         (merged by the host app); DataContext is an AzureSetupViewModel. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" Style="{DynamicResource MaBodyScroll}">
        <StackPanel Margin="16" MaxWidth="720" HorizontalAlignment="Left">
            <TextBlock Text="Azure" Style="{DynamicResource MaHeading}" />
            <TextBlock Style="{DynamicResource MaMutedText}" TextWrapping="Wrap" Margin="0,4,0,12"
                       Text="Load and Save use an App Configuration store (every name) and a Key Vault (key values), as you. Nothing secret is stored for Azure access." />

            <!-- Sign-in -->
            <Border Style="{DynamicResource MaCard}" Padding="12" Margin="0,0,0,12">
                <DockPanel LastChildFill="False">
                    <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Text="{Binding SignedInAs}" />
                    <Button DockPanel.Dock="Right" Content="Sign out" Margin="8,0,0,0"
                            Style="{DynamicResource MaButton}" Command="{Binding SignOutCommand}" />
                    <Button DockPanel.Dock="Right" Content="Sign in" Margin="8,0,0,0"
                            Style="{DynamicResource MaPrimaryButton}" Command="{Binding SignInCommand}" />
                    <Button DockPanel.Dock="Right" Content="Refresh" Margin="8,0,0,0"
                            Style="{DynamicResource MaButton}" Command="{Binding RefreshCommand}" />
                </DockPanel>
            </Border>

            <!-- Picker -->
            <Border Style="{DynamicResource MaCard}" Padding="12" Margin="0,0,0,12" IsEnabled="{Binding IsSignedIn}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Subscription" Style="{DynamicResource MaSectionLabel}" VerticalAlignment="Center" />
                    <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,4" AutomationProperties.Name="Subscription"
                              ItemsSource="{Binding Subscriptions}" SelectedItem="{Binding SelectedSubscription}" DisplayMemberPath="DisplayName" />

                    <TextBlock Grid.Row="1" Text="Resource group" Style="{DynamicResource MaSectionLabel}" VerticalAlignment="Center" />
                    <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,4" AutomationProperties.Name="Resource group"
                              ItemsSource="{Binding ResourceGroups}" SelectedItem="{Binding SelectedResourceGroup}" DisplayMemberPath="Name" />

                    <TextBlock Grid.Row="2" Text="Key Vault" Style="{DynamicResource MaSectionLabel}" VerticalAlignment="Center" />
                    <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,4" AutomationProperties.Name="Key Vault"
                              ItemsSource="{Binding KeyVaults}" SelectedItem="{Binding SelectedKeyVault}" DisplayMemberPath="Name" />

                    <TextBlock Grid.Row="3" Text="App Configuration store" Style="{DynamicResource MaSectionLabel}" VerticalAlignment="Center" />
                    <ComboBox Grid.Row="3" Grid.Column="1" Margin="0,4" AutomationProperties.Name="App Configuration store"
                              ItemsSource="{Binding AppConfigurationStores}" SelectedItem="{Binding SelectedAppConfigurationStore}" DisplayMemberPath="Name" />

                    <TextBlock Grid.Row="4" Text="Environment name" Style="{DynamicResource MaSectionLabel}" VerticalAlignment="Center" />
                    <TextBox Grid.Row="4" Grid.Column="1" Margin="0,4" AutomationProperties.Name="Environment name"
                             Style="{DynamicResource MaTextBox}" Text="{Binding EnvironmentName, UpdateSourceTrigger=PropertyChanged}" />

                    <Button Grid.Row="5" Grid.Column="1" HorizontalAlignment="Right" Margin="0,8,0,0" Content="Save environment"
                            Style="{DynamicResource MaPrimaryButton}" Command="{Binding SaveEnvironmentCommand}" />
                </Grid>
            </Border>

            <!-- Remembered environments -->
            <TextBlock Text="Environments" Style="{DynamicResource MaSectionLabel}" Margin="0,0,0,4" />
            <DockPanel Margin="0,0,0,12">
                <Button DockPanel.Dock="Right" Content="Remove" Margin="8,0,0,0" VerticalAlignment="Top"
                        Style="{DynamicResource MaButton}" Command="{Binding RemoveEnvironmentCommand}" />
                <ListBox ItemsSource="{Binding Environments}" SelectedItem="{Binding SelectedEnvironment}" MinHeight="60"
                         Style="{DynamicResource MaList}" AutomationProperties.Name="Environments">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="4">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                <TextBlock Style="{DynamicResource MaMutedText}">
                                    <Run Text="{Binding KeyVaultName, Mode=OneWay}" /><Run Text=" + " /><Run Text="{Binding AppConfigurationName, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <TextBlock Text="{Binding Status}" Style="{DynamicResource MaMutedText}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Error}" Foreground="{DynamicResource MaBad}" TextWrapping="Wrap" Margin="0,4,0,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
